# Read by docker-compose and make. `make` copies this to .env for you.
#
# These configure the containers only. Inside the compose network the database
# is always reached as `employee:5432`, so there is no host/container hostname
# to keep in sync - _PORT is just the port published to your machine.
#
# The Go service has its own defaults for running on the host (see pkg/config);
# it reads API_* variables, not these.

# development
POSTGRES_DB=employee
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSL=disable

# testing
TEST_POSTGRES_DB=employee_test
TEST_POSTGRES_PORT=5442
TEST_POSTGRES_USER=postgres
TEST_POSTGRES_PASSWORD=postgres
TEST_POSTGRES_SSL=disable
